# ==========================================
# StockWatch Application Configuration
# ==========================================

# Server Port
PORT=3000

# Monitoring Check Frequency
# Options: cron expression (e.g. "0 */2 * * *" for every 2 hours) OR check interval in minutes (e.g. 60)
CHECK_INTERVAL_MINUTES=60

# Default Reorder Threshold if column is missing or blank in Google Sheet
DEFAULT_REORDER_THRESHOLD=10

# Alert Cooldown Period (in hours) - minimum time before re-alerting for the same low stock item
COOLDOWN_HOURS=24

# Target Phone Numbers to receive alerts (comma-separated, with country code e.g. +2348012345678)
RECIPIENT_PHONE_NUMBERS=+2348012345678

# ==========================================
# Google Sheets API Configuration
# ==========================================
# Google Sheet ID (extracted from sheet URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit)
SPREADSHEET_ID=your_google_spreadsheet_id_here
SHEET_NAME=Sheet1

# Path to Service Account JSON key file OR raw JSON string OR individual fields
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json
# Alternative:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=stockwatch-service@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Set to true to force Mock Sheets mode (useful for testing without connecting Google Sheet API)
USE_MOCK_SHEETS=true

# ==========================================
# Messaging Gateway Configuration
# Options for MESSAGING_PROVIDER: MOCK | TERMII | AFRICAS_TALKING
# ==========================================
MESSAGING_PROVIDER=MOCK

# --- TERMII CONFIGURATION ---
# Termii API Key from https://termii.com
TERMII_API_KEY=your_termii_api_key
# Sender ID approved on Termii (default: "N-Alert" or custom)
TERMII_SENDER_ID=StockWatch
# Channel: generic | whatsapp | dnd
TERMII_CHANNEL=generic

# --- AFRICA'S TALKING CONFIGURATION ---
# Africa's Talking API Key from https://africastalking.com
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=StockWatch
